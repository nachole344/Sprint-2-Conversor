<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootProgrammer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080D18">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="18dp"
            android:paddingBottom="30dp">

            <!-- NAVEGACION -->
            <TextView
                android:id="@+id/btnBackProgrammer"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:paddingEnd="16dp"
                android:text="‹   VOLVER"
                android:textColor="#60A5FA"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Volver a la pantalla anterior"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <!-- CABECERA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VERTEX / TOOLS"
                    android:textColor="#60A5FA"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.18"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Programmer"
                    android:textColor="#F8FAFC"
                    android:textSize="32sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Conversor de bases y codificación"
                    android:textColor="#94A3B8"
                    android:textSize="14sp"/>

                <View
                    android:layout_width="42dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="17dp"
                    android:background="#60A5FA"/>

            </LinearLayout>

            <!-- TARJETA CONVERSOR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/bg_card">

                <!-- CABECERA TARJETA -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="CONVERSIÓN"
                        android:textColor="#F8FAFC"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="DEV TOOLS"
                        android:textColor="#60A5FA"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_input"/>

                </LinearLayout>

                <!-- TIPO CONVERSION -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="TIPO DE CONVERSIÓN"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"/>

                <Spinner
                    android:id="@+id/spProgrammerMode"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/bg_input"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:spinnerMode="dropdown"
                    android:contentDescription="Seleccionar tipo de conversión"/>

                <!-- BASES PERSONALIZADAS -->
                <LinearLayout
                    android:id="@+id/layoutCustomBases"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="19dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <!-- BASE ORIGEN -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="7dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BASE ORIGEN"
                            android:textColor="#94A3B8"
                            android:textSize="10sp"
                            android:textStyle="bold"/>

                        <Spinner
                            android:id="@+id/spBaseFrom"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_input"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:contentDescription="Seleccionar base de origen"/>

                    </LinearLayout>

                    <!-- BASE DESTINO -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="7dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BASE DESTINO"
                            android:textColor="#94A3B8"
                            android:textSize="10sp"
                            android:textStyle="bold"/>

                        <Spinner
                            android:id="@+id/spBaseTo"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_input"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:contentDescription="Seleccionar base de destino"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- DIVISOR -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="23dp"
                    android:background="#253044"/>

                <!-- ENTRADA -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="ENTRADA"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"/>

                <EditText
                    android:id="@+id/etProgrammerValue"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/bg_input"
                    android:hint="Introduce un número o texto..."
                    android:textColor="#F8FAFC"
                    android:textColorHint="#64748B"
                    android:textSize="15sp"
                    android:padding="15dp"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:minLines="2"
                    android:maxLines="4"
                    android:scrollbars="vertical"
                    android:importantForAutofill="no"/>

                <!-- BOTON -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnProgrammerConvert"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="@null"
                    android:background="@drawable/bg_button_blue"
                    android:text="CONVERTIR   →"
                    android:textColor="#080D18"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:stateListAnimator="@null"/>

                <!-- RESULTADO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/bg_input">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:background="#60A5FA"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="9dp"
                            android:text="RESULTADO"
                            android:textColor="#94A3B8"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1"/>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvProgrammerResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="El resultado aparecerá aquí"
                        android:textColor="#60A5FA"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textIsSelectable="true"
                        android:breakStrategy="simple"
                        android:paddingBottom="4dp"/>

                </LinearLayout>

            </LinearLayout>

            <!-- PIE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:text="NUMBER SYSTEMS  /  ASCII  /  HEX"
                android:textColor="#475569"
                android:textSize="10sp"
                android:letterSpacing="0.12"/>

        </LinearLayout>

    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
