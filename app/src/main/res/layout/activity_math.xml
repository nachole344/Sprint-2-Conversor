<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootMath"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080D18">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="30dp">

            <!-- CABECERA -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBackMath"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_input"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:text="←  Volver"
                android:textAllCaps="false"
                android:textColor="#60A5FA"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:minWidth="0dp"
                android:minHeight="0dp"/>


            <!-- TITULO -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="Matemáticas"
                android:textColor="#F1F5F9"
                android:textSize="30sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="28dp"
                android:text="Herramientas para tus cálculos"
                android:textColor="#94A3B8"
                android:textSize="13sp"/>


            <!-- 01 FRACCIONES -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/bg_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="01  /  FRACCIONES"
                    android:textColor="#60A5FA"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10"/>

                <!-- PRIMERA FRACCION -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="19dp"
                    android:layout_marginBottom="9dp"
                    android:text="Primera fracción"
                    android:textColor="#F1F5F9"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etFractionNum1"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:hint="Numerador"
                        android:inputType="numberSigned"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:textColor="#F1F5F9"
                        android:textColorHint="#64748B"
                        android:textSize="13sp"
                        android:singleLine="true"/>

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="/"
                        android:textColor="#60A5FA"
                        android:textSize="25sp"
                        android:textStyle="bold"/>

                    <EditText
                        android:id="@+id/etFractionDen1"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:hint="Denominador"
                        android:inputType="numberSigned"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:textColor="#F1F5F9"
                        android:textColorHint="#64748B"
                        android:textSize="13sp"
                        android:singleLine="true"/>

                </LinearLayout>

                <!-- SEGUNDA FRACCION -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:layout_marginBottom="9dp"
                    android:text="Segunda fracción"
                    android:textColor="#F1F5F9"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etFractionNum2"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:hint="Numerador"
                        android:inputType="numberSigned"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:textColor="#F1F5F9"
                        android:textColorHint="#64748B"
                        android:textSize="13sp"
                        android:singleLine="true"/>

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="/"
                        android:textColor="#60A5FA"
                        android:textSize="25sp"
                        android:textStyle="bold"/>

                    <EditText
                        android:id="@+id/etFractionDen2"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:hint="Denominador"
                        android:inputType="numberSigned"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:textColor="#F1F5F9"
                        android:textColorHint="#64748B"
                        android:textSize="13sp"
                        android:singleLine="true"/>

                </LinearLayout>

                <!-- OPERACION -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="8dp"
                    android:text="OPERACIÓN"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"/>

                <Spinner
                    android:id="@+id/spFractionOperation"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_input"
                    android:backgroundTint="@null"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnFraction"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_button"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:text="Calcular fracción  →"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvFractionResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:padding="14dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center"
                    android:text="Resultado"
                    android:textColor="#60A5FA"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

            </LinearLayout>


            <!-- 02 PORCENTAJES -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/bg_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="02  /  PORCENTAJES"
                    android:textColor="#60A5FA"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10"/>

                <EditText
                    android:id="@+id/etPercentage"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_input"
                    android:hint="Porcentaje (%)"
                    android:inputType="numberDecimal|numberSigned"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#F1F5F9"
                    android:textColorHint="#64748B"
                    android:textSize="14sp"
                    android:singleLine="true"/>

                <EditText
                    android:id="@+id/etPercentageValue"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input"
                    android:hint="Cantidad"
                    android:inputType="numberDecimal|numberSigned"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#F1F5F9"
                    android:textColorHint="#64748B"
                    android:textSize="14sp"
                    android:singleLine="true"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnPercentage"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_button"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:text="Calcular porcentaje  →"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvPercentageResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:padding="14dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center"
                    android:text="Resultado"
                    android:textColor="#60A5FA"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

            </LinearLayout>


            <!-- 03 RAICES -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/bg_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="03  /  RAÍCES"
                    android:textColor="#60A5FA"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10"/>

                <EditText
                    android:id="@+id/etRootNumber"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_input"
                    android:hint="Número"
                    android:inputType="numberDecimal|numberSigned"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#F1F5F9"
                    android:textColorHint="#64748B"
                    android:textSize="14sp"
                    android:singleLine="true"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnRoot"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_button"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:text="Calcular raíz cuadrada  →"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvRootResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:padding="14dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center"
                    android:text="Resultado"
                    android:textColor="#60A5FA"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

            </LinearLayout>


            <!-- 04 POTENCIAS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/bg_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="04  /  POTENCIAS"
                    android:textColor="#60A5FA"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10"/>

                <EditText
                    android:id="@+id/etPowerBase"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_input"
                    android:hint="Base"
                    android:inputType="numberDecimal|numberSigned"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#F1F5F9"
                    android:textColorHint="#64748B"
                    android:textSize="14sp"
                    android:singleLine="true"/>

                <EditText
                    android:id="@+id/etPowerExponent"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input"
                    android:hint="Exponente"
                    android:inputType="numberDecimal|numberSigned"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#F1F5F9"
                    android:textColorHint="#64748B"
                    android:textSize="14sp"
                    android:singleLine="true"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnPower"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_button"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:text="Calcular potencia  →"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvPowerResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:padding="14dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center"
                    android:text="Resultado"
                    android:textColor="#60A5FA"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

            </LinearLayout>


            <!-- 05 ANGULOS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/bg_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="05  /  ÁNGULOS"
                    android:textColor="#60A5FA"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10"/>

                <EditText
                    android:id="@+id/etAngle"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_input"
                    android:hint="Valor del ángulo"
                    android:inputType="numberDecimal|numberSigned"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#F1F5F9"
                    android:textColorHint="#64748B"
                    android:textSize="14sp"
                    android:singleLine="true"/>

                <Spinner
                    android:id="@+id/spAngleDirection"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input"
                    android:backgroundTint="@null"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnAngle"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_button"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:text="Convertir ángulo  →"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvAngleResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:padding="14dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center"
                    android:text="Resultado"
                    android:textColor="#60A5FA"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

            </LinearLayout>


            <!-- FOOTER -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:text="VERTEX  •  CONVERTER STUDIO"
                android:textColor="#475569"
                android:textSize="10sp"
                android:letterSpacing="0.12"/>

        </LinearLayout>

    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
