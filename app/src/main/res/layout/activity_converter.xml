<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootConverter"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080D18">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="30dp">

            <!-- CABECERA -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_input"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:text="←  Volver"
                android:textAllCaps="false"
                android:textColor="#60A5FA"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:minWidth="0dp"
                android:minHeight="0dp" />

            <!-- TITULO -->

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Conversor"
                android:textColor="#F1F5F9"
                android:textSize="29sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="27dp"
                android:text="Convierte entre diferentes unidades"
                android:textColor="#94A3B8"
                android:textSize="13sp" />

            <!-- TARJETA VALOR ORIGINAL -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="#3B82F6" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:text="VALOR ORIGINAL"
                        android:textColor="#60A5FA"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.10" />

                </LinearLayout>

                <EditText
                    android:id="@+id/etValueFrom"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="15dp"
                    android:background="@drawable/bg_input"
                    android:hint="Introduce un valor"
                    android:inputType="numberDecimal|numberSigned"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:textColor="#F1F5F9"
                    android:textColorHint="#64748B"
                    android:textSize="16sp"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:layout_marginBottom="8dp"
                    android:text="UNIDAD DE ORIGEN"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <Spinner
                    android:id="@+id/spFrom"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:backgroundTint="#3B82F6"
                    android:popupBackground="#111B2D"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:spinnerMode="dropdown" />

            </LinearLayout>

            <!-- INDICADOR DE CONVERSION -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:layout_width="45dp"
                    android:layout_height="1dp"
                    android:background="#26364F" />

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center"
                    android:text="↓"
                    android:textColor="#60A5FA"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="45dp"
                    android:layout_height="1dp"
                    android:background="#26364F" />

            </LinearLayout>

            <!-- TARJETA VALOR DESTINO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="#60A5FA" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:text="VALOR DESTINO"
                        android:textColor="#60A5FA"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.10" />

                </LinearLayout>

                <EditText
                    android:id="@+id/etValueTo"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="15dp"
                    android:background="@drawable/bg_input"
                    android:hint="El resultado aparecerá aquí"
                    android:inputType="text"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:textColor="#60A5FA"
                    android:textColorHint="#64748B"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:clickable="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:layout_marginBottom="8dp"
                    android:text="UNIDAD DE DESTINO"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <Spinner
                    android:id="@+id/spTo"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:backgroundTint="#3B82F6"
                    android:popupBackground="#111B2D"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:spinnerMode="dropdown" />

            </LinearLayout>

            <!-- BOTON CONVERTIR -->

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnConvert"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_button"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:text="CONVERTIR   →"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- RESULTADO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RESULTADO DE LA CONVERSIÓN"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10" />

                <TextView
                    android:id="@+id/tvResult"
                    android:textIsSelectable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:text="Esperando conversión..."
                    android:textColor="#60A5FA"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:gravity="center" />

            </LinearLayout>

            <!-- NOTA (solo visible en algunas categorías, p. ej. monedas) -->

            <TextView
                android:id="@+id/tvNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:visibility="gone"/>

            <!-- PIE -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="27dp"
                android:gravity="center"
                android:text="VERTEX  •  CONVERTER STUDIO"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:letterSpacing="0.12" />

        </LinearLayout>

    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>